<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A biblioteca de sons é dividida com o Mistral (FonteDeSons): só apps assinados com a mesma chave entram.
         O Mistral declara a mesma permissão, então tanto faz qual dos dois é instalado primeiro -->
    <permission
        android:name="com.implacavel.alarme.permission.SONS"
        android:protectionLevel="signature" />
    <!-- O Gemma é dividido com o Chiron Routine (ServicoDeIa): também só pra apps com a mesma chave -->
    <permission
        android:name="com.implacavel.alarme.permission.IA"
        android:protectionLevel="signature" />

    <!-- O receiver do Chiron exige esta permissão de quem lhe conta o despertador (AvisoAoChiron) -->
    <uses-permission android:name="com.implacavel.alarme.permission.IA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarme no minuto exato. USE_EXACT_ALARM é concedida na instalação (Android 13+);
         a Play Store só aceita em apps de despertador, mas aqui o APK é seu. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Depois do STOP: o GPS, o microfone e a câmera seguem com a tela fechada (Android 14+ exige os tipos) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Missão pra desligar: ouvir "stop" e ver os olhos abertos pela câmera frontal -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- O YouTube ao lado da câmera, na etapa da câmera (PaginaYoutube.kt), e no "conversa + caminhada":
         as notícias e as metas (a IA roda no celular) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Caminhada da manhã pelo GPS (só isso). Pedida no botão "Liberar" das permissões (Poder.LOCALIZACAO);
         no Android 12+, a precisa (FINE) tem que ser pedida junto com a aproximada (COARSE) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sem câmera ou microfone o app ainda instala; a missão cai pra um botão -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- Sem GPS o app também instala; na caminhada, celular sem GPS é defeito e o alarme desliga -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 11+: sem isso o app não enxerga o serviço de reconhecimento de voz do sistema -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- E o sintetizador de voz, pra saudação falada depois do STOP -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- E o Chiron, que recebe o aviso do despertador e da missão viva -->
        <package android:name="io.github.luiz_nast.chiron.routine" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Tema">
        <!-- 11-08: a GPU do LiteRT-LM (o guia Kotlin pede as duas; sem elas no aparelho, fica a CPU) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela do alarme: aparece por cima da tela de bloqueio e funciona antes do primeiro desbloqueio.
             No Android 8.0 (API 26) o mesmo efeito vem das flags de janela em AlarmeActivity.acordarTela(). -->
        <!-- configChanges: girar o celular ou trocar o modo escuro (o app é sempre claro) não recria a tela,
             então câmera, microfone e o vídeo do YouTube não reiniciam -->
        <activity
            android:name=".AlarmeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            tools:targetApi="27"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Tema.Alarme"
            android:turnScreenOn="true" />

        <service
            android:name=".AlarmeService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Toca o alarme (som, vibração e tela cheia) até o usuário desligar" />
        </service>

        <!-- Teste da IA do celular, sem som: só pelo cabo (o adb tem a permissão DUMP; app comum, não). Veja TesteDaIa.kt -->
        <receiver
            android:name=".TesteDaIa"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Teste do alto-falante (se a voz começa baixa), só pelo cabo, como o TesteDaIa. Veja TesteDoSom.kt -->
        <activity
            android:name=".TesteDoSom"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="" />

        <!-- Teste do reconhecimento de voz com a voz da pessoa, sem som, só pelo cabo. Veja TesteDaEscuta.kt -->
        <activity
            android:name=".TesteDaEscuta"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="" />

        <!-- Teste do GPS da caminhada, sem alarme e sem som, só pelo cabo, como o TesteDoSom. Veja TesteDoGps.kt -->
        <activity
            android:name=".TesteDoGps"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="" />

        <!-- Encerrar o alarme em andamento, só pelo cabo (permissão DUMP, como o TesteDaIa). Veja PararPeloCabo.kt -->
        <receiver
            android:name=".PararPeloCabo"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Administrador do aparelho, sem política: só o que o Knox exige pra travar o desligar. Veja AdminDoAlarme.kt -->
        <receiver
            android:name=".AdminDoAlarme"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- A trava do desligar pelo Knox, só pelo cabo (permissão DUMP, como o PararPeloCabo). Veja TravaDoDesligar.kt -->
        <receiver
            android:name=".TravaPeloCabo"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- O resultado da licença do Knox, que ele manda só a este app (só vira uma linha no log) -->
        <receiver
            android:name=".LicencaDoKnox"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samsung.android.knox.intent.action.KNOX_LICENSE_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AlarmeReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ServicoDeIa"
            android:exported="true"
            android:permission="com.implacavel.alarme.permission.IA">
            <intent-filter>
                <action android:name="com.implacavel.alarme.action.IA" />
            </intent-filter>
        </service>

        <provider
            android:name=".FonteDeSons"
            android:authorities="com.implacavel.alarme.sons"
            android:exported="true"
            android:permission="com.implacavel.alarme.permission.SONS" />

        <!-- O modo da manhã pro Mistral (FonteDoModo): só leitura, com a mesma permissão de assinatura dos sons -->
        <provider
            android:name=".FonteDoModo"
            android:authorities="com.implacavel.alarme.modo"
            android:exported="true"
            android:readPermission="com.implacavel.alarme.permission.SONS"
            android:writePermission="com.implacavel.alarme.permission.SONS" />
    </application>
</manifest>
